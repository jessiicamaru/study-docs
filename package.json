{
  "name": "study-docs",
  "productName": "Study Docs",
  "version": "0.18.1",
  "description": "Quản lý tài liệu học (Markdown + HTML) trên Windows",
  "author": "jessiicamaru",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "release": "node scripts/release.mjs",
    "make-icon": "electron scripts/make-icon.cjs"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.14",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@lezer/common": "^1.5.5",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/vie": "^1.0.0",
    "@types/d3-transition": "^3.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "codemirror": "^6.0.2",
    "d3-transition": "^3.0.2",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.18",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "epubjs": "^0.3.93",
    "happy-dom": "^21.0.4",
    "highlight.js": "^11.12.0",
    "ical.js": "^2.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.16.47",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0",
    "minisearch": "^7.2.0",
    "parse5": "^8.1.1",
    "pdfjs-dist": "^5.4.394",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "local.studydocs.app",
    "productName": "Study Docs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Tài liệu Markdown",
        "role": "Viewer"
      },
      {
        "ext": "epub",
        "name": "EPUB",
        "description": "Sách EPUB",
        "role": "Viewer"
      },
      {
        "ext": [
          "mobi",
          "azw3",
          "azw"
        ],
        "name": "Kindle",
        "description": "Sách Kindle",
        "role": "Viewer"
      },
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "HTML",
        "description": "Trang HTML",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "PDF",
        "description": "Tài liệu PDF",
        "role": "Viewer"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Study Docs"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jessiicamaru",
        "repo": "study-docs",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "out/main/search-worker.js",
      "out/main/chunks/**"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
